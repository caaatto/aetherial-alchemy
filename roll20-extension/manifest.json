{
  "manifest_version": 3,
  "name": "Aetherial Alchemy — Roll20 Sync",
  "version": "2.0",
  "description": "Alchemy sidebar directly inside Roll20 — inventory, brewing, and D&D sheet sync.",

  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://catto.at/*",
    "https://app.roll20.net/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://catto.at/*"],
      "js": ["alchemy-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.roll20.net/editor/*"],
      "js": ["roll20-bridge.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["herbs.json", "recipes.json"],
      "matches": ["https://app.roll20.net/*"]
    }
  ]
}
