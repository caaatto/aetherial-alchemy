{
  "manifest_version": 3,
  "name": "Aetherial Alchemy — Roll20 Sync",
  "version": "2.10",
  "description": "Alchemy sidebar directly inside Roll20 — inventory, brewing, D&D sheet sync, and live party inventory for the GM.",
  "key": "",
  "update_url": "https://raw.githubusercontent.com/caaatto/aetherial-alchemy/master/roll20-extension/updates.xml",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://catto.at/*",
    "https://app.roll20.net/*"
  ],
  "action": {
    "default_title": "Aetherial Alchemy — Roll20 Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://catto.at/*"
      ],
      "js": [
        "alchemy-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.roll20.net/editor/*"
      ],
      "js": [
        "roll20-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.roll20.net/editor/*"
      ],
      "js": [
        "roll20-bridge.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "herbs.json",
        "recipes.json"
      ],
      "matches": [
        "https://app.roll20.net/*"
      ],
      "_comment": "Offline fallback — primary source is https://catto.at/api/v1"
    }
  ]
}
